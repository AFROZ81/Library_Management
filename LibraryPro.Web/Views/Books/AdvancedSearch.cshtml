@model LibraryPro.Web.Models.AdvancedSearchViewModel

@{
    ViewData["Title"] = "Advanced Search";
}

<div class="books-page books-page--form">
    <div class="container-fluid px-3 px-md-4 py-4 py-lg-5">
        <div class="books-shell books-shell--narrow">
            <header class="page-header page-header--compact">
                <div class="page-header__title-block">
                    <p class="page-header__eyebrow">Catalog</p>
                    <h1 class="page-header__title">Advanced Search</h1>
                </div>
                <div class="page-header__actions">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary books-header-action books-header-action--ghost">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                </div>
            </header>

            <div class="books-form-card">
                <div class="books-form-card__header">
                    <div class="books-form-card__icon"><i class="bi bi-search"></i></div>
                    <div>
                        <h2>Advanced Search</h2>
                        <p>Find books using detailed filters</p>
                    </div>
                </div>

                <div class="books-form-card__body">
                    <form asp-action="AdvancedSearch" method="post">
                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="SearchCriteria.Title" class="form-label">Title</label>
                                <input asp-for="SearchCriteria.Title" class="form-control books-search-input"
                                       placeholder="Search by title" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="SearchCriteria.Author" class="form-label">Author</label>
                                <input asp-for="SearchCriteria.Author" class="form-control books-search-input"
                                       placeholder="Search by author" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="SearchCriteria.ISBN" class="form-label">ISBN</label>
                                <input asp-for="SearchCriteria.ISBN" class="form-control books-search-input"
                                       placeholder="Search by ISBN" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="SearchCriteria.Genre" class="form-label">Genre</label>
                                <input asp-for="SearchCriteria.Genre" class="form-control books-search-input"
                                       placeholder="Search by genre" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="SearchCriteria.MinPublicationYear" class="form-label">Min Year</label>
                                <input asp-for="SearchCriteria.MinPublicationYear"
                                       class="form-control books-search-input" type="number" placeholder="From" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="SearchCriteria.MaxPublicationYear" class="form-label">Max Year</label>
                                <input asp-for="SearchCriteria.MaxPublicationYear"
                                       class="form-control books-search-input" type="number" placeholder="To" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="SearchCriteria.SortBy" class="form-label">Sort By</label>
                                <select asp-for="SearchCriteria.SortBy" class="form-select books-search-input">
                                    <option value="">Select...</option>
                                    <option value="title">Title</option>
                                    <option value="author">Author</option>
                                    <option value="publicationyear">Publication Year</option>
                                    <option value="popularity">Popularity</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="SearchCriteria.SortOrder" class="form-label">Sort Order</label>
                                <select asp-for="SearchCriteria.SortOrder" class="form-select books-search-input">
                                    <option value="">Select...</option>
                                    <option value="asc">Ascending</option>
                                    <option value="desc">Descending</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="form-check books-check-row">
                                    <input asp-for="SearchCriteria.AvailableOnly" class="form-check-input" />
                                    <label asp-for="SearchCriteria.AvailableOnly" class="form-check-label">Show only
                                        available books</label>
                                    </div>
                                </div>
                            </div>

                            <div class="books-form-card__actions">
                                <button type="submit" class="btn btn-primary books-submit-btn">
                                    <i class="bi bi-search me-2"></i>Search Books
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .books-search-input {
            min-height: 48px;
            border-color: #dfe7f1;
            background: #fff;
        }

        .books-search-input:focus {
            border-color: #1d4ed8;
            box-shadow: none;
        }

        .books-check-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.9rem 1rem;
        }

        .books-check-row .form-check-input {
            width: 1.2rem;
            height: 1.2rem;
            margin-top: 0;
        }

        .books-check-row .form-check-label {
            margin: 0;
            color: var(--books-text);
            font-weight: 600;
        }
    </style>
