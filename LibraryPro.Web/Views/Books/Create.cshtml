@model LibraryPro.Web.Models.Entities.Book

@{
    ViewData["Title"] = "Register New Book";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<div class="books-page books-page--form">
    <div class="container-fluid px-3 px-md-4 py-4 py-lg-5">
        <div class="books-shell books-shell--narrow">
            <header class="page-header page-header--compact">
                <div class="page-header__title-block">
                    <p class="page-header__eyebrow">Catalog</p>
                    <h1 class="page-header__title">Register New Book</h1>
                </div>
                <div class="page-header__actions">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary books-header-action books-header-action--ghost">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                </div>
            </header>

            <div class="books-form-card">
                <div class="books-form-card__header">
                    <div class="books-form-card__icon"><i class="bi bi-book-half"></i></div>
                    <div>
                        <h2>Register New Book</h2>
                        <p>Add a new volume to your catalog</p>
                    </div>
                </div>

                <div class="books-form-card__body">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="Title" class="form-label">Title</label>
                                <div class="input-group books-input-group">
                                    <span class="input-group-text"><i class="bi bi-type"></i></span>
                                    <input asp-for="Title" class="form-control" placeholder="e.g. The Great Gatsby" />
                                </div>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Author" class="form-label">Author</label>
                                <div class="input-group books-input-group">
                                    <span class="input-group-text"><i class="bi bi-person-lines-fill"></i></span>
                                    <input asp-for="Author" class="form-control" placeholder="Author Name" />
                                </div>
                                <span asp-validation-for="Author" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ISBN" class="form-label">ISBN</label>
                                <div class="input-group books-input-group">
                                    <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                    <input asp-for="ISBN" id="isbnInput" class="form-control" placeholder="ISBN-13" />
                                    <button type="button" id="lookupBtn" class="btn btn-outline-primary"
                                            title="Lookup book details">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ISBN" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Genre" class="form-label">Genre</label>
                                <div class="input-group books-input-group select2-bootstrap-fix">
                                    <span class="input-group-text"><i class="bi bi-tags"></i></span>
                                    <select asp-for="Genre" id="genreSelect" class="form-select" multiple="multiple">
                                        <option value="Fiction">Fiction</option>
                                        <option value="Non-Fiction">Non-Fiction</option>
                                        <option value="Science">Science</option>
                                        <option value="History">History</option>
                                        <option value="Adventure">Adventure</option>
                                        <option value="Fantasy">Fantasy</option>
                                        <option value="Mystery">Mystery</option>
                                        <option value="Romance">Romance</option>
                                        <option value="Thriller">Thriller</option>
                                        <option value="Quest">Quest</option>
                                        <option value="Fable">Fable</option>
                                        <option value="Classic">Classic</option>
                                        <option value="Psychological Thriller">Psychological Thriller</option>
                                        <option value="Poetry">Poetry</option>
                                        <option value="Sci-Fi">Sci-Fi</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Genre" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="PublicationYear" class="form-label">Year</label>
                                <div class="input-group books-input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                                    <select asp-for="PublicationYear" class="form-select">
                                        <option value="">-- Year --</option>
                                        @for (int year = DateTime.Now.Year; year >= 1800; year--)
                                        {
                                            <option value="@year">@year</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="TotalCopies" class="form-label">Stock Quantity</label>
                                <div class="input-group books-input-group">
                                    <span class="input-group-text"><i class="bi bi-plus-square"></i></span>
                                    <input asp-for="TotalCopies" class="form-control" type="number" min="1" value="1" />
                                </div>
                                <span asp-validation-for="TotalCopies" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Book Cover Image</label>
                                <div class="input-group books-input-group">
                                    <span class="input-group-text"><i class="bi bi-image"></i></span>
                                    <input type="file" name="imageFile" class="form-control"
                                           accept=".jpg,.jpeg,.png,.webp" />
                                </div>
                                <div class="form-text small text-muted">Allowed formats: JPG, JPEG, PNG, WEBP. Maximum
                                    size: 5MB.</div>
                                </div>
                            </div>

                            <div class="books-form-card__actions">
                                <button type="submit" class="btn btn-primary books-submit-btn">
                                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>Save to Catalog
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .books-page--form {
        min-height: calc(100vh - 56px);
        background: #f8fafc;
        padding: 0 0 2rem;
    }

    .books-shell {
        width: min(100%, 1280px);
        margin: 0 auto;
    }

    .books-shell--narrow {
        width: min(100%, 1100px);
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 0.25rem 0 0.75rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.35);
        margin: 0 auto 1.5rem;
        width: 100%;
    }

    .page-header__title-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .page-header__eyebrow {
        margin: 0;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #64748b;
    }

    .page-header__title {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3.2rem);
        letter-spacing: -0.06em;
        line-height: 0.95;
        font-weight: 700;
        color: #0f172a;
    }

    .page-header__actions {
        margin-left: auto;
        display: flex;
        align-items: center;
    }

    .page-header--compact {
        margin-bottom: 1.25rem;
    }

    .books-header-action--ghost {
        background: #fff;
        border: 1px solid #dfe7f1;
        color: #0f172a;
        min-height: 42px;
        border-radius: 12px;
        font-weight: 600;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
    }

    .books-form-card {
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid #dfe7f1;
        border-radius: 24px;
        box-shadow: 0 18px 35px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        width: 100%;
        margin: 0 auto;
    }

    .books-form-card__header {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
        color: #fff;
        padding: 1.5rem 1.5rem 1.25rem;
    }

    .books-form-card__icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.12);
        font-size: 1.7rem;
    }

    .books-form-card__header h2 {
        margin: 0;
        font-weight: 800;
        font-size: clamp(1.5rem, 2vw, 2rem);
    }

    .books-form-card__header p {
        margin: 0.25rem 0 0;
        opacity: 0.8;
        font-size: 0.9rem;
    }

    .books-form-card__body {
        padding: 1.4rem 1.4rem 1.6rem;
    }

    .form-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #475569;
        margin-bottom: 0.5rem;
    }

    .books-input-group .input-group-text {
        background: #f8fafc;
        border-color: #dfe7f1;
        color: #334155;
    }

    .books-input-group .form-control,
    .books-input-group .form-select {
        min-height: 48px;
        border-color: #dfe7f1;
        border-left: none;
        background: #fff;
        color: #0f172a;
    }

    .books-input-group input:focus,
    .books-input-group select:focus {
        border-color: #1d4ed8;
        box-shadow: none;
    }

    .books-input-group .btn {
        min-height: 48px;
    }

    .select2-bootstrap-fix {
        display: flex !important;
        flex-wrap: nowrap !important;
    }

    .select2-container {
        flex: 1 1 auto !important;
        width: 1% !important;
    }

    .select2-container--default .select2-selection--multiple {
        border: 1px solid #dfe7f1 !important;
        border-left: none !important;
        border-top-left-radius: 0 !important;
        border-bottom-left-radius: 0 !important;
        min-height: 48px !important;
        padding: 4px 6px !important;
        display: flex !important;
        align-items: center !important;
    }

    .select2-selection__choice {
        background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%) !important;
        color: white !important;
        border: none !important;
        border-radius: 6px !important;
        margin: 2px 6px 2px 0 !important;
        padding: 5px 8px 5px 22px !important;
        position: relative !important;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        position: absolute !important;
        left: 6px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        color: rgba(255, 255, 255, 0.8) !important;
        margin: 0 !important;
        padding: 0 4px !important;
    }

    .select2-search--inline,
    .select2-search__field {
        margin: 0 !important;
        height: 30px !important;
        line-height: 30px !important;
    }

    .books-form-card__actions {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #edf2f7;
    }

    .books-submit-btn {
        min-height: 52px;
        width: 100%;
        border-radius: 12px;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        box-shadow: 0 12px 24px rgba(29, 78, 216, 0.18);
    }

    @@media (max-width: 767.98px) {
        .books-form-card__header {
            padding: 1.2rem 1rem;
        }

        .books-form-card__body {
            padding: 1rem;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-header__actions {
            margin-left: 0;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
        $('#genreSelect').select2({
        placeholder: 'Select genres',
        allowClear: true,
        width: '100%'
        });

        $('#lookupBtn').click(function () {
        const isbn = $('#isbnInput').val().trim();
        if (!isbn) {
        alert('Please enter an ISBN');
        return;
        }

        $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

        $.get('@Url.Action("LookupByISBN", "Books")', { isbn: isbn })
        .done(function (response) {
        if (response.success) {
        const data = response.data;
        if (data.title) $('input[name="Title"]').val(data.title);
        if (data.author) $('input[name="Author"]').val(data.author);
        if (data.isbn) $('input[name="ISBN"]').val(data.isbn);
        if (data.publicationYear) $('select[name="PublicationYear"]').val(data.publicationYear);
        if (data.genres && data.genres.length > 0) {
        $('#genreSelect').val(data.genres).trigger('change');
        }
        } else {
        alert(response.message || 'Book not found');
        }
        })
        .fail(function () {
        alert('Error looking up book. Please try again.');
        })
        .always(function () {
        $('#lookupBtn').prop('disabled', false).html('<i class="bi bi-search"></i>');
        });
        });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}