@model LibraryPro.Web.Models.Entities.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <div class="row">
                        <div class="col-md-4 mb-4 mb-md-0 text-center">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center rounded shadow-sm" style="height: 300px;">
                                    <i class="bi bi-book text-muted" style="font-size: 5rem;"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <h2 class="fw-bold mb-1">@Model.Title</h2>
                            <p class="text-muted fs-5 mb-4">by @Model.Author</p>

                            <div class="row g-3 mb-4">
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block">ISBN</small>
                                        <span class="fw-bold">@Model.ISBN</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block">Publication Year</small>
                                        <span class="fw-bold">@Model.PublicationYear</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block">Available Copies</small>
                                        <span class="fw-bold @(Model.AvailableCopies > 0 ? "text-success" : "text-danger")">
                                            @Model.AvailableCopies / @Model.TotalCopies
                                        </span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block">Genre</small>
                                        <span class="fw-bold">@(Model.Genre != null ? string.Join(", ", Model.Genre) : "N/A")</span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block">Barcode</small>
                                        <span class="fw-bold text-primary">@Model.Barcode</span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                                </a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Reservations" asp-action="Create" method="post">
                                        <input type="hidden" name="bookId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-primary" @(Model.AvailableCopies > 0 ? "" : "")>
                                            <i class="bi bi-bookmark-plus me-1"></i> Reserve Book
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
