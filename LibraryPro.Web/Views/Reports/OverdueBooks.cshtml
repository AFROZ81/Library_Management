@model LibraryPro.Web.Services.OverdueBooksReportViewModel

@{
    ViewData["Title"] = "Overdue Books Report";
}

<div class="report-page">
    <div class="container-fluid px-3 px-md-4 py-4 py-lg-5">
        <div class="report-shell">
            <div class="page-header">
                <div class="page-header__title-block">
                    <p class="page-header__eyebrow">Operations</p>
                    <h1 class="page-header__title">Overdue Books</h1>
                </div>
                <div class="page-header__actions">
                    <a asp-action="Index" class="page-header__back-link">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>

            <div class="report-card">
                <div class="report-card__header report-card__header--danger">
                    <div class="report-card__header-icon"><i class="bi bi-exclamation-triangle"></i></div>
                    <div>
                        <h2>Overdue report</h2>
                        <p>Generated: @Model.GeneratedAt.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                    <div class="report-header-actions">
                        <a asp-action="OverdueBooksPdf" class="btn btn-light btn-sm report-export-btn">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </a>
                        <a asp-action="OverdueBooksExcel" class="btn btn-success btn-sm report-export-btn">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </a>
                    </div>
                </div>

                <div class="report-card__body report-card__body--wide">
                    <div class="stat-grid stat-grid--single">
                        <div class="stat-card stat-card--danger">
                            <span class="stat-card__label">Total Overdue Books</span>
                            <strong>@Model.TotalOverdueBooks</strong>
                        </div>
                    </div>

                    <div class="section-heading">
                        <h3>Overdue Books</h3>
                    </div>

                    @if (Model.OverdueBooks.Any())
                    {
                        <div class="table-wrap">
                            <table class="report-table">
                                <thead>
                                    <tr>
                                        <th>Book</th>
                                        <th>Author</th>
                                        <th>Member</th>
                                        <th>Due Date</th>
                                        <th>Days Overdue</th>
                                        <th>Late Fee</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var overdue in Model.OverdueBooks)
                                    {
                                        <tr
                                            class="@(overdue.DaysOverdue > 30 ? "report-row report-row--danger" : "report-row report-row--warning")">
                                            <td data-label="Book">@overdue.BookTitle</td>
                                            <td data-label="Author">@overdue.BookAuthor</td>
                                            <td data-label="Member">@overdue.MemberName</td>
                                            <td data-label="Due Date">@overdue.DueDate.ToString("dd MMM yyyy")</td>
                                            <td data-label="Days Overdue"><strong>@overdue.DaysOverdue</strong></td>
                                            <td data-label="Late Fee"><strong>₹@overdue.LateFee.ToString("F2")</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="status-message status-message--success">
                            <i class="bi bi-check-circle me-2"></i>No overdue books found!
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --report-bg: #f8fafc;
        --report-card: #ffffff;
        --report-border: #e5e7eb;
        --report-text: #0f172a;
        --report-muted: #64748b;
        --report-shadow: 0 14px 30px rgba(15, 23, 42, 0.06);
    }

    .report-page {
        min-height: calc(100vh - 56px);
        background: var(--report-bg);
        padding: 0 0 2.5rem;
    }

    .report-shell {
        max-width: none;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.25rem 0 0.5rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.35);
        margin-bottom: 1.5rem;
    }

    .page-header__title-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .page-header__actions {
        margin-left: auto;
        display: flex;
        align-items: center;
    }

    .page-header__back-link {
        display: inline-flex;
        align-items: center;
        color: var(--report-muted);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        transition: color 0.2s ease;
    }

    .page-header__back-link:hover {
        color: var(--report-text);
        text-decoration: none;
    }

    .page-header__eyebrow {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--report-muted);
    }

    .page-header__title {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3.5rem);
        letter-spacing: -0.06em;
        line-height: 0.95;
        font-weight: 700;
        color: var(--report-text);
    }

    .report-card {
        background: var(--report-card);
        border: 1px solid var(--report-border);
        border-radius: 22px;
        box-shadow: var(--report-shadow);
        overflow: hidden;
    }

    .report-card__header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.4rem 1.5rem;
        border-bottom: 1px solid rgba(229, 231, 235, 0.9);
    }

    .report-card__header--danger {
        background: linear-gradient(135deg, #991b1b 0%, #dc2626 100%);
        color: #fff;
    }

    .report-card__header-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: 1.4rem;
    }

    .report-card__header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .report-card__header p {
        margin: 0.25rem 0 0;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.92rem;
    }

    .report-header-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .report-export-btn {
        border-radius: 10px;
        font-weight: 600;
    }

    .report-card__body {
        padding: 1.5rem;
    }

    .report-card__body--wide {
        padding: 1.5rem 1.5rem 1.75rem;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: minmax(0, 420px);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        border-radius: 18px;
        padding: 1.1rem 1rem;
        border: 1px solid var(--report-border);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 120px;
    }

    .stat-card--danger {
        background: #fef2f2;
    }

    .stat-card__label {
        display: block;
        color: var(--report-muted);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .stat-card strong {
        color: var(--report-text);
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 800;
        line-height: 1;
    }

    .section-heading {
        margin: 0 0 0.9rem;
    }

    .section-heading h3 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--report-text);
    }

    .table-wrap {
        overflow: hidden;
        border: 1px solid var(--report-border);
        border-radius: 14px;
        background: #fff;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 700px;
    }

    .report-table th,
    .report-table td {
        padding: 0.9rem 1rem;
        border-bottom: 1px solid #edf2f7;
        text-align: left;
        vertical-align: middle;
    }

    .report-table thead th {
        background: #f8fafc;
        color: var(--report-text);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .report-row--warning {
        background: rgba(255, 251, 235, 0.8);
    }

    .report-row--danger {
        background: rgba(254, 242, 242, 0.9);
    }

    .report-table tbody tr:last-child td {
        border-bottom: none;
    }

    .report-table tbody tr:hover {
        background: rgba(241, 245, 249, 0.7);
    }

    .status-message {
        display: flex;
        align-items: center;
        padding: 1rem 1.1rem;
        border-radius: 12px;
        font-weight: 600;
    }

    .status-message--success {
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        color: #166534;
    }

    @@media (max-width: 767.98px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .report-card__header {
            flex-wrap: wrap;
            align-items: center;
        }

        .report-header-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .report-card__body {
            padding: 1rem;
        }

        .table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .report-table {
            min-width: 100%;
        }

        .report-table thead {
            display: none;
        }

        .report-table,
        .report-table tbody,
        .report-table tr,
        .report-table td {
            display: block;
            width: 100%;
        }

        .report-table tbody {
            padding: 0.5rem;
            display: grid;
            gap: 0.75rem;
        }

        .report-table tr {
            background: #fff;
            border: 1px solid var(--report-border);
            border-radius: 14px;
            padding: 0.8rem 0.9rem;
        }

        .report-table td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border: none;
            padding: 0.45rem 0;
        }

        .report-table td::before {
            content: attr(data-label);
            color: var(--report-muted);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
    }
</style>
