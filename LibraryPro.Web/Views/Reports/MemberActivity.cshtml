@model LibraryPro.Web.Controllers.ReportDateRangeViewModel

@{
    ViewData["Title"] = "Member Activity Report";
}

<div class="report-page">
    <div class="container-fluid px-3 px-md-4 py-4 py-lg-5">
        <div class="report-shell report-shell--narrow">
            <div class="page-header">
                <div class="page-header__title-block">
                    <p class="page-header__eyebrow">Operations</p>
                    <h1 class="page-header__title">Member Activity Report</h1>
                </div>
                <div class="page-header__actions">
                    <a asp-action="Index" class="page-header__back-link">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>

            <div class="report-card report-card--form">
                <div class="report-card__header report-card__header--info">
                    <div class="report-card__header-icon"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <h2>Generate report</h2>
                        <p>Review borrowing trends across your member base.</p>
                    </div>
                </div>

                <div class="report-card__body">
                    <form asp-action="MemberActivity" method="post" class="report-form">
                        <div asp-validation-summary="ModelOnly" class="form-alert form-alert--error"></div>

                        <div class="field-group">
                            <label asp-for="StartDate" class="field-label">Start Date</label>
                            <div class="input-wrap input-wrap--info">
                                <span class="input-icon"><i class="bi bi-calendar"></i></span>
                                <input asp-for="StartDate" type="date" class="field-input" />
                            </div>
                            <span asp-validation-for="StartDate" class="field-validation-error"></span>
                        </div>

                        <div class="field-group">
                            <label asp-for="EndDate" class="field-label">End Date</label>
                            <div class="input-wrap input-wrap--info">
                                <span class="input-icon"><i class="bi bi-calendar-check"></i></span>
                                <input asp-for="EndDate" type="date" class="field-input" />
                            </div>
                            <span asp-validation-for="EndDate" class="field-validation-error"></span>
                        </div>

                        <div class="report-form__actions">
                            <button type="submit" class="btn btn-info report-submit text-white">
                                <i class="bi bi-bar-chart-fill me-2"></i>Generate Report
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --report-bg: #f8fafc;
        --report-card: #ffffff;
        --report-border: #e5e7eb;
        --report-text: #0f172a;
        --report-muted: #64748b;
        --report-info: #0284c7;
        --report-shadow: 0 14px 30px rgba(15, 23, 42, 0.06);
    }

    .report-page {
        min-height: calc(100vh - 56px);
        background: var(--report-bg);
        padding: 0 0 2.5rem;
    }

    .report-shell {
        max-width: 1500px;
        width: min(100%, 1500px);
        margin: 0 auto;
        padding: 0 0.5rem;
    }

    .report-shell--narrow {
        max-width: 1280px;
        width: min(100%, 1280px);
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.25rem 0 0.5rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.35);
        margin-bottom: 1.5rem;
    }

    .page-header__title-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .page-header__actions {
        margin-left: auto;
        display: flex;
        align-items: center;
    }

    .page-header__back-link {
        display: inline-flex;
        align-items: center;
        color: var(--report-muted);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        transition: color 0.2s ease;
    }

    .page-header__back-link:hover {
        color: var(--report-text);
        text-decoration: none;
    }

    .page-header__eyebrow {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--report-muted);
    }

    .page-header__title {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3.5rem);
        letter-spacing: -0.06em;
        line-height: 0.95;
        font-weight: 700;
        color: var(--report-text);
    }

    .report-card {
        background: var(--report-card);
        border: 1px solid var(--report-border);
        border-radius: 22px;
        box-shadow: var(--report-shadow);
        overflow: hidden;
        margin: 0 auto;
        width: 100%;
    }

    .report-card__header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.4rem 1.5rem;
        border-bottom: 1px solid rgba(229, 231, 235, 0.9);
    }

    .report-card__header--info {
        background: linear-gradient(135deg, #0f172a 0%, #0284c7 100%);
        color: #fff;
    }

    .report-card__header-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: 1.4rem;
    }

    .report-card__header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .report-card__header p {
        margin: 0.25rem 0 0;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.92rem;
    }

    .report-card__body {
        padding: clamp(1.25rem, 2vw, 2rem);
    }

    .report-form {
        max-width: 820px;
        margin: 0 auto;
        padding-inline: clamp(0.25rem, 1vw, 1rem);
    }

    .form-alert {
        padding: 0.9rem 1rem;
        border-radius: 12px;
        font-size: 0.9rem;
        margin-bottom: 1.25rem;
    }

    .form-alert--error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .field-group {
        margin-bottom: 1.4rem;
    }

    .field-label {
        display: block;
        margin-bottom: 0.55rem;
        color: var(--report-muted);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .input-wrap {
        display: flex;
        align-items: center;
        background: #fff;
        border: 1px solid #dfe7f1;
        border-radius: 12px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .input-wrap:focus-within {
        border-color: rgba(2, 132, 199, 0.7);
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.08);
    }

    .input-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 52px;
        color: var(--report-info);
        background: #f8fafc;
        border-right: 1px solid #e2e8f0;
        border-radius: 12px 0 0 12px;
    }

    .field-input {
        border: none;
        width: 100%;
        height: 52px;
        background: transparent;
        padding: 0.8rem 1rem;
        color: var(--report-text);
        outline: none;
    }

    .field-validation-error {
        display: block;
        margin-top: 0.4rem;
        color: #dc2626;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .report-form__actions {
        display: grid;
        gap: 0.75rem;
        margin: 1.75rem auto 0;
        max-width: 820px;
    }

    .report-submit {
        width: 100%;
        min-height: 52px;
        border-radius: 12px;
        font-weight: 700;
    }

    @@media (max-width: 767.98px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .report-card__body {
            padding: 1rem;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
