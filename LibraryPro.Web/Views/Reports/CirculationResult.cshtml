@model LibraryPro.Web.Services.CirculationReportViewModel

@{
    ViewData["Title"] = "Circulation Report Results";
}

<div class="report-page">
    <div class="container-fluid px-3 px-md-4 py-4 py-lg-5">
        <div class="report-shell">
            <div class="page-header">
                <div class="page-header__title-block">
                    <p class="page-header__eyebrow">Analytics</p>
                    <h1 class="page-header__title">Circulation Report</h1>
                </div>
                <div class="page-header__actions">
                    <a asp-action="Index" class="page-header__back-link">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>

            <div class="report-card">
                <div class="report-card__header report-card__header--primary">
                    <div class="report-card__header-icon"><i class="bi bi-book-half"></i></div>
                    <div>
                        <h2>Results</h2>
                        <p>@Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="report-header-actions">
                        <a asp-action="CirculationPdf" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                           class="btn btn-light btn-sm report-export-btn">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </a>
                        <a asp-action="CirculationExcel" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                           class="btn btn-success btn-sm report-export-btn">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </a>
                    </div>
                </div>

                <div class="report-card__body report-card__body--wide">
                    <div class="stat-grid">
                        <div class="stat-card stat-card--primary">
                            <span class="stat-card__label">Total Issued</span>
                            <strong>@Model.TotalLoansIssued</strong>
                        </div>
                        <div class="stat-card stat-card--success">
                            <span class="stat-card__label">Total Returned</span>
                            <strong>@Model.TotalLoansReturned</strong>
                        </div>
                        <div class="stat-card stat-card--warning">
                            <span class="stat-card__label">Active Loans</span>
                            <strong>@Model.ActiveLoans</strong>
                        </div>
                        <div class="stat-card stat-card--info">
                            <span class="stat-card__label">Avg Duration</span>
                            <strong>@Model.AverageLoanDuration.ToString("F1")</strong>
                            <small>days</small>
                        </div>
                    </div>

                    <div class="section-heading">
                        <h3>Daily Circulation</h3>
                    </div>

                    <div class="table-wrap">
                        <table class="report-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Loans Issued</th>
                                    <th>Loans Returned</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var daily in Model.DailyCirculation)
                                {
                                    <tr>
                                        <td data-label="Date">@daily.Date.ToString("dd MMM yyyy")</td>
                                        <td data-label="Loans Issued">@daily.LoansIssued</td>
                                        <td data-label="Loans Returned">@daily.LoansReturned</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --report-bg: #f8fafc;
        --report-card: #ffffff;
        --report-border: #e5e7eb;
        --report-text: #0f172a;
        --report-muted: #64748b;
        --report-primary: #1d4ed8;
        --report-primary-soft: #eff6ff;
        --report-shadow: 0 14px 30px rgba(15, 23, 42, 0.06);
    }

    .report-page {
        min-height: calc(100vh - 56px);
        background: var(--report-bg);
        padding: 0 0 2.5rem;
    }

    .report-shell {
        max-width: none;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.25rem 0 0.5rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.35);
        margin-bottom: 1.5rem;
    }

    .page-header__title-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .page-header__actions {
        margin-left: auto;
        display: flex;
        align-items: center;
    }

    .page-header__back-link {
        display: inline-flex;
        align-items: center;
        color: var(--report-muted);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        transition: color 0.2s ease;
    }

    .page-header__back-link:hover {
        color: var(--report-text);
        text-decoration: none;
    }

    .page-header__eyebrow {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--report-muted);
    }

    .page-header__title {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3.5rem);
        letter-spacing: -0.06em;
        line-height: 0.95;
        font-weight: 700;
        color: var(--report-text);
    }

    .report-card {
        background: var(--report-card);
        border: 1px solid var(--report-border);
        border-radius: 22px;
        box-shadow: var(--report-shadow);
        overflow: hidden;
    }

    .report-card__header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.4rem 1.5rem;
        border-bottom: 1px solid rgba(229, 231, 235, 0.9);
    }

    .report-card__header--primary {
        background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%);
        color: #fff;
    }

    .report-card__header-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: 1.4rem;
    }

    .report-card__header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .report-card__header p {
        margin: 0.25rem 0 0;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.92rem;
    }

    .report-header-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .report-export-btn {
        border-radius: 10px;
        font-weight: 600;
    }

    .report-card__body {
        padding: 1.5rem;
    }

    .report-card__body--wide {
        padding: 1.5rem 1.5rem 1.75rem;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        border-radius: 18px;
        padding: 1.1rem 1rem;
        border: 1px solid var(--report-border);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 120px;
    }

    .stat-card--primary {
        background: #eff6ff;
    }

    .stat-card--success {
        background: #ecfdf5;
    }

    .stat-card--warning {
        background: #fffbeb;
    }

    .stat-card--info {
        background: #f0f9ff;
    }

    .stat-card__label {
        display: block;
        color: var(--report-muted);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .stat-card strong {
        color: var(--report-text);
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 800;
        line-height: 1;
    }

    .stat-card small {
        color: var(--report-muted);
        margin-top: 0.2rem;
        font-weight: 600;
    }

    .section-heading {
        margin: 0 0 0.9rem;
    }

    .section-heading h3 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--report-text);
    }

    .table-wrap {
        overflow: hidden;
        border: 1px solid var(--report-border);
        border-radius: 14px;
        background: #fff;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 420px;
    }

    .report-table th,
    .report-table td {
        padding: 0.9rem 1rem;
        border-bottom: 1px solid #edf2f7;
        text-align: left;
        vertical-align: middle;
    }

    .report-table thead th {
        background: #f8fafc;
        color: var(--report-text);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .report-table tbody tr:last-child td {
        border-bottom: none;
    }

    .report-table tbody tr:hover {
        background: rgba(241, 245, 249, 0.7);
    }

    @@media (max-width: 991.98px) {
        .stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .report-card__header {
            flex-wrap: wrap;
            align-items: center;
        }

        .report-header-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .stat-grid {
            grid-template-columns: 1fr;
        }

        .report-card__body {
            padding: 1rem;
        }

        .table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .report-table {
            min-width: 100%;
        }

        .report-table thead {
            display: none;
        }

        .report-table,
        .report-table tbody,
        .report-table tr,
        .report-table td {
            display: block;
            width: 100%;
        }

        .report-table tbody {
            padding: 0.5rem;
            display: grid;
            gap: 0.75rem;
        }

        .report-table tr {
            background: #fff;
            border: 1px solid var(--report-border);
            border-radius: 14px;
            padding: 0.8rem 0.9rem;
        }

        .report-table td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border: none;
            padding: 0.45rem 0;
        }

        .report-table td::before {
            content: attr(data-label);
            color: var(--report-muted);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
    }
</style>
