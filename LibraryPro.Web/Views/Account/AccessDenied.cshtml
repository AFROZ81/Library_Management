@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Access Denied</h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-4">
                    <i class="bi bi-exclamation-triangle" style="font-size: 4rem; color: #dc3545;"></i>
                </div>
                <h3>You don't have permission to access this page.</h3>
                <p class="text-muted">Please contact an administrator if you believe this is an error.</p>
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Return to Home</a>
            </div>
        </div>
    </div>
</div>
