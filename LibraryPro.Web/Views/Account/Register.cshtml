@model LibraryPro.Web.Models.ViewModels.RegisterViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create Account";
}

<div class="auth-shell auth-shell--simple auth-shell--register">
    <div class="auth-card-shell is-flipped" id="authCardRotator">
        <div class="auth-card-face auth-card-face--front">
            <section class="auth-form-card auth-form-card--standalone">
                <div class="auth-form-card__logo">
                    <img src="~/logo/Libris.png" alt="Libris Logo" class="auth-logo" />
                </div>
                <div class="auth-form-card__header">
                    <span class="auth-form-card__eyebrow">Create account</span>
                    <h2>Set up your profile</h2>
                </div>

                <form asp-action="Register" method="post" id="registerForm" class="auth-submit-form">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="validation-light">
                            <div class="d-flex align-items-center gap-2 mb-1 fw-bold">
                                <i class="bi bi-exclamation-triangle-fill"></i> Registration Issues
                            </div>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <div class="form-group-light">
                        <label asp-for="Email" class="form-label-light">Email address</label>
                        <div class="input-wrapper-light">
                            <i class="bi bi-envelope input-icon-left"></i>
                            <input asp-for="Email" class="input-control-light" placeholder="name@librarypro.com"
                                   required autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="form-group-light">
                        <label asp-for="Password" class="form-label-light">Password</label>
                        <div class="input-wrapper-light">
                            <i class="bi bi-shield-lock input-icon-left"></i>
                            <input asp-for="Password" id="RegPassword" type="password" class="input-control-light"
                                   placeholder="Minimum 6 characters" required autocomplete="new-password" />
                            <button type="button" class="toggle-pass-btn" data-target="RegPassword"
                                    title="Toggle visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-group-light">
                        <label asp-for="ConfirmPassword" class="form-label-light">Confirm password</label>
                        <div class="input-wrapper-light">
                            <i class="bi bi-shield-check input-icon-left"></i>
                            <input asp-for="ConfirmPassword" id="RegConfirmPassword" type="password"
                                   class="input-control-light" placeholder="Re-enter password" required
                                   autocomplete="new-password" />
                            <button type="button" class="toggle-pass-btn" data-target="RegConfirmPassword"
                                    title="Toggle visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <p class="auth-policy">
                        By registering, you agree to our <a href="javascript:void(0);" class="auth-link">Terms</a> and
                        <a href="javascript:void(0);" class="auth-link">Privacy Policy</a>.
                    </p>

                    <button type="submit" class="btn-submit-light btn-submit-emerald">
                        <span class="btn-text">Create Account</span>
                        <div class="spinner-border spinner-border-sm d-none" role="status"></div>
                    </button>
                </form>

                <div class="auth-form-card__footer">
                    <span>Already have an account?</span>
                    <button type="button" class="auth-link auth-switch-link" data-auth-target="login">Sign in</button>
                </div>
            </section>
        </div>

        <div class="auth-card-face auth-card-face--back">
            <section class="auth-form-card auth-form-card--standalone">
                <div class="auth-form-card__header">
                    <span class="auth-form-card__eyebrow">Member sign in</span>
                    <h2>Access your dashboard</h2>
                </div>

                <form asp-action="Login" method="post" id="loginForm" class="auth-submit-form">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="validation-light">
                            <div class="d-flex align-items-center gap-2 mb-1 fw-bold">
                                <i class="bi bi-exclamation-triangle-fill"></i> Authentication Failed
                            </div>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <div class="form-group-light">
                        <label for="LoginEmail" class="form-label-light">Email address</label>
                        <div class="input-wrapper-light">
                            <i class="bi bi-envelope input-icon-left"></i>
                            <input id="LoginEmail" name="Email" class="input-control-light"
                                   placeholder="name@librarypro.com" required autocomplete="username" />
                        </div>
                    </div>

                    <div class="form-group-light">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="LoginPassword" class="form-label-light mb-0">Password</label>
                            <a href="javascript:void(0);" class="auth-link">Forgot password?</a>
                        </div>
                        <div class="input-wrapper-light">
                            <i class="bi bi-shield-lock input-icon-left"></i>
                            <input id="LoginPassword" name="Password" type="password" class="input-control-light"
                                   placeholder="••••••••" required autocomplete="current-password" />
                            <button type="button" class="toggle-pass-btn" data-target="LoginPassword"
                                    title="Toggle visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-check-light">
                        <label class="auth-toggle" for="LoginRememberMe">
                            <input id="LoginRememberMe" name="RememberMe" type="checkbox" class="auth-toggle__input" />
                            <span class="auth-toggle__slider"></span>
                        </label>
                        <label for="LoginRememberMe" class="form-check-label-light">Keep me signed in on this
                            device</label>
                        </div>

                        <button type="submit" class="btn-submit-light">
                            <span class="btn-text">Sign In</span>
                            <div class="spinner-border spinner-border-sm d-none" role="status"></div>
                        </button>
                    </form>

                    <div class="auth-form-card__footer">
                        <span>Need an account?</span>
                        <button type="button" class="auth-link auth-switch-link" data-auth-target="register">Create
                            one</button>
                        </div>
                    </section>
                </div>
            </div>
        </div>

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }
