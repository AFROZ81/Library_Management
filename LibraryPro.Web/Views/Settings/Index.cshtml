@model LibraryPro.Web.Models.Entities.LibrarySettings

@{
    ViewData["Title"] = "System Policy Settings";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-sliders text-primary me-2"></i>Library Policy Settings</h2>
            <p class="text-muted mb-0">Configure operational rules, loan periods, fine rates, and member limits.</p>
        </div>
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
            <i class="bi bi-clock-history me-1"></i> Last updated: @Model.UpdatedAt.ToString("g")
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Index" method="post">
        <input type="hidden" asp-for="Id" />
        
        <div class="row g-4">
            <!-- Circulation & Loan Rules Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 bg-primary-subtle text-primary rounded-3">
                                <i class="bi bi-book-half fs-5"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Circulation & Loan Rules</h5>
                                <small class="text-muted">Manage loan durations and member limits</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="DefaultLoanPeriodDays" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="DefaultLoanPeriodDays" class="form-control" type="number" min="1" max="365" />
                                <span class="input-group-text bg-light">Days</span>
                            </div>
                            <span asp-validation-for="DefaultLoanPeriodDays" class="text-danger small"></span>
                            <div class="form-text">Standard initial loan period for books issued to members.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaxBooksPerMember" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="MaxBooksPerMember" class="form-control" type="number" min="1" max="50" />
                                <span class="input-group-text bg-light">Books</span>
                            </div>
                            <span asp-validation-for="MaxBooksPerMember" class="text-danger small"></span>
                            <div class="form-text">Maximum number of active book loans permitted per member simultaneously.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaxRenewalAttempts" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="MaxRenewalAttempts" class="form-control" type="number" min="0" max="10" />
                                <span class="input-group-text bg-light">Times</span>
                            </div>
                            <span asp-validation-for="MaxRenewalAttempts" class="text-danger small"></span>
                            <div class="form-text">Maximum times a member can extend their book loan due date.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fines & Penalties Policy Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 bg-warning-subtle text-warning rounded-3">
                                <i class="bi bi-cash-stack fs-5"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Fines & Penalties Policy</h5>
                                <small class="text-muted">Configure overdue penalty calculations</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="DailyFineRate" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input asp-for="DailyFineRate" class="form-control" type="number" step="0.50" min="0" />
                                <span class="input-group-text bg-light">/ Day</span>
                            </div>
                            <span asp-validation-for="DailyFineRate" class="text-danger small"></span>
                            <div class="form-text">Daily fine amount charged for each day a book is returned after its due date.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GracePeriodDays" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="GracePeriodDays" class="form-control" type="number" min="0" max="30" />
                                <span class="input-group-text bg-light">Days</span>
                            </div>
                            <span asp-validation-for="GracePeriodDays" class="text-danger small"></span>
                            <div class="form-text">Number of days after due date before fines start accumulating.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-bold">
                <i class="bi bi-save me-1"></i> Save Policy Settings
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
