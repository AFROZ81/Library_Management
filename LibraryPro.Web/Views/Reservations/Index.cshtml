@model IEnumerable<LibraryPro.Web.Models.Entities.BookReservation>

@{
    ViewData["Title"] = "Reservations";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calendar-check text-primary me-2"></i> Book Reservations</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Reserved On</th>
                        <th>Queue Position</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Book?.Title</td>
                            <td>@item.Member?.Name</td>
                            <td>@item.ReservationDate.ToString("g")</td>
                            <td><span class="badge bg-secondary">#@item.QueuePosition</span></td>
                            <td>
                                @if (item.Status == LibraryPro.Web.Models.Entities.ReservationStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (item.Status == LibraryPro.Web.Models.Entities.ReservationStatus.Fulfilled)
                                {
                                    <span class="badge bg-success">Fulfilled</span>
                                }
                                else if (item.Status == LibraryPro.Web.Models.Entities.ReservationStatus.Cancelled)
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == LibraryPro.Web.Models.Entities.ReservationStatus.Pending)
                                {
                                    <form asp-action="Cancel" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No reservations found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
