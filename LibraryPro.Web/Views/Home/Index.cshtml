@model LibraryPro.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">
    <div class="container-fluid px-3 px-md-4 py-4 py-lg-5">
        <div class="dashboard-shell">
            <header class="page-header">
                <div class="page-header__title-block">
                    <p class="page-header__eyebrow">Overview</p>
                    <h1 class="page-header__title">Library Insights</h1>
                </div>
                <div class="page-header__actions">
                    <span class="dashboard-sync-pill">
                        <i class="bi bi-clock-history me-2"></i>
                        Last sync: @DateTime.Now.ToString("t")
                    </span>
                </div>
            </header>

            <section class="stats-grid" aria-label="Library metrics overview">
                @{
                    var stats = new[] {
                        new { Title = "Total Books", Value = Model.TotalBooks.ToString(), Icon = "bi-book", Color = "primary" },
                        new { Title = "Active Patrons", Value = Model.TotalMembers.ToString(), Icon = "bi-people", Color =
         "success" },
                        new { Title = "Live Loans", Value = Model.ActiveLoans.ToString(), Icon = "bi-arrow-repeat", Color =
      "warning" },
                        new { Title = "Unpaid Fines", Value = "₹" + Model.TotalPendingFines.ToString("N0"), Icon =
              "bi-currency-rupee", Color = "danger" }
                    };
                }

                @foreach (var item in stats)
                {
                    <article class="stat-card">
                        <div class="stat-card__icon stat-card__icon--@item.Color">
                            <i class="bi @item.Icon"></i>
                        </div>
                        <div class="stat-card__content">
                            <span>@item.Title</span>
                            <h2>@item.Value</h2>
                        </div>
                    </article>
                }
            </section>

            <section class="dashboard-grid dashboard-grid--top">
                <article class="panel panel--wide">
                    <div class="panel__header">
                        <div>
                            <p class="panel__eyebrow">Performance</p>
                            <h2>Borrowing Trends</h2>
                        </div>
                        <button class="btn btn-sm btn-light panel__chip" type="button">Weekly</button>
                    </div>
                    <div class="chart-wrap chart-wrap--large">
                        <canvas id="loanChart"></canvas>
                    </div>
                </article>

                <article class="panel panel--compact">
                    <div class="panel__header panel__header--stacked">
                        <div>
                            <p class="panel__eyebrow">Inventory</p>
                            <h2>Stock Health</h2>
                        </div>
                    </div>

                    <div class="inventory-health">
                        <div class="inventory-health__meter">
                            <div class="inventory-health__fill" style="width: @Model.AvailabilityRate%"></div>
                        </div>
                        <div class="inventory-health__value">@Model.AvailabilityRate.ToString("F1")%</div>
                        <p>Books currently available</p>
                    </div>

                    <div class="inventory-genres">
                        <p class="panel__label">Popular Genres</p>
                        <div class="chart-wrap chart-wrap--small">
                            <canvas id="genreChart"></canvas>
                        </div>
                    </div>
                </article>
            </section>

            <section class="dashboard-grid dashboard-grid--bottom">
                <article class="panel">
                    <div class="panel__header">
                        <div>
                            <p class="panel__eyebrow">Alerts</p>
                            <h2>Critical Overdue</h2>
                        </div>
                    </div>

                    <div class="table-shell">
                        <table class="dashboard-table">
                            <thead>
                                <tr>
                                    <th>Member</th>
                                    <th>Book Title</th>
                                    <th>Due Date</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var loan in Model.CriticalOverdueLoans)
                                {
                                    <tr>
                                        <td data-label="Member">@loan.Member?.Name</td>
                                        <td data-label="Book Title">@loan.Book?.Title</td>
                                        <td data-label="Due Date"><span
                                            class="badge badge--danger">@loan.DueDate.ToString("MMM dd")</span></td>
                                            <td data-label="Action" class="text-end">
                                                <button class="btn btn-sm dashboard-table__action" type="button">Notify</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </article>

                    <article class="panel">
                        <div class="panel__header">
                            <div>
                                <p class="panel__eyebrow">Members</p>
                                <h2>Top Borrowers</h2>
                            </div>
                            <span class="panel__badge">All Time</span>
                        </div>

                        <div class="borrower-list">
                            @if (Model.TopBorrowers != null && Model.TopBorrowers.Any())
                            {
                                foreach (var borrower in Model.TopBorrowers)
                                {
                                    <div class="borrower-row">
                                        <div class="borrower-row__identity">
                                            <div class="borrower-avatar">
                                                @(string.IsNullOrEmpty(borrower.MemberName) ? "???" :
                                        borrower.MemberName.Substring(0, Math.Min(2, borrower.MemberName.Length)).ToUpper())
                                            </div>
                                            <div>
                                                <p>@borrower.MemberName</p>
                                                <span>@borrower.MemberEmail</span>
                                            </div>
                                        </div>
                                        <span class="borrower-count">@borrower.LoanCount Books</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="bi bi-person-dash"></i>
                                    <p>No borrowing history available yet.</p>
                                </div>
                            }
                        </div>
                    </article>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
            };

            new Chart(document.getElementById('loanChart'), {
            type: 'line',
            data: {
            labels: @Json.Serialize(Model.WeeklyLabels),
            datasets: [{
            data: @Json.Serialize(Model.WeeklyIssueCounts),
            borderColor: '#2563eb',
            backgroundColor: 'rgba(37, 99, 235, 0.08)',
            fill: true,
            tension: 0.4,
            pointRadius: 5,
            pointHoverRadius: 8,
            borderWidth: 3
            }]
            },
            options: {
            ...chartOptions,
            scales: {
            y: { beginAtZero: true, suggestedMax: 5, ticks: { stepSize: 1 } },
            x: { grid: { display: false } }
            }
            }
            });

            new Chart(document.getElementById('genreChart'), {
            type: 'doughnut',
            data: {
            labels: @Json.Serialize(Model.GenreLabels),
            datasets: [{
            data: @Json.Serialize(Model.GenreCounts),
            backgroundColor: [
            '#0d6efd', '#ffc107', '#198754', '#dc3545', '#6610f2', '#fd7e14', '#20c997', '#0dcaf0'
            ],
            borderWidth: 2,
            borderColor: '#ffffff'
            }]
            },
            options: {
            ...chartOptions,
            cutout: '72%',
            plugins: {
            legend: {
            display: true,
            position: 'bottom',
            labels: {
            usePointStyle: true,
            padding: 15,
            font: { size: 11 }
            }
            }
            }
            }
            });
        </script>
    }

    <style>
        .dashboard-page {
        min-height: calc(100vh - 56px);
        background: #f8fafc;
        padding: 0 0 2rem;
        }

        .dashboard-shell {
        width: 100%;
        max-width: none;
        margin: 0;
        }

        .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 0.25rem 0 0.75rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.35);
        margin: 0 auto 1.5rem;
        width: 100%;
        }

        .page-header__title-block {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        }

        .page-header__eyebrow {
        margin: 0;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #64748b;
        }

        .page-header__title {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3.2rem);
        letter-spacing: -0.06em;
        line-height: 0.95;
        font-weight: 700;
        color: #0f172a;
        }

        .page-header__actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        }

        .dashboard-sync-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        border: 1px solid #dfe7f1;
        border-radius: 12px;
        color: #0f172a;
        padding: 0.7rem 1rem;
        font-size: 0.82rem;
        font-weight: 600;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
        }

        .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
        }

        .stat-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.75);
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 1rem 1.1rem;
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.04);
        }

        .stat-card__icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        }

        .stat-card__icon--primary {
        background: #e7f1ff;
        color: #2563eb;
        }

        .stat-card__icon--success {
        background: #e6f4ea;
        color: #198754;
        }

        .stat-card__icon--warning {
        background: #fff8e1;
        color: #d97706;
        }

        .stat-card__icon--danger {
        background: #fce8e8;
        color: #dc3545;
        }

        .stat-card__content {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
        }

        .stat-card__content span {
        color: #64748b;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        }

        .stat-card__content strong {
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 800;
        letter-spacing: -0.05em;
        color: #0f172a;
        }

        .dashboard-grid {
        display: grid;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
        }

        .dashboard-grid--top {
        grid-template-columns: 2fr 1fr;
        }

        .dashboard-grid--bottom {
        grid-template-columns: 1.4fr 1fr;
        }

        .panel {
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        box-shadow: 0 18px 35px rgba(15, 23, 42, 0.05);
        padding: 1.2rem 1.2rem 1.15rem;
        }

        .panel__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
        }

        .panel__header--stacked {
        margin-bottom: 1.25rem;
        }

        .panel__eyebrow {
        margin: 0;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: #64748b;
        text-transform: uppercase;
        }

        .panel h2 {
        margin: 0.2rem 0 0;
        font-size: 1.2rem;
        font-weight: 800;
        color: #0f172a;
        }

        .panel__chip,
        .panel__badge {
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #0f172a;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.45rem 0.8rem;
        }

        .chart-wrap {
        position: relative;
        width: 100%;
        }

        .chart-wrap--large {
        height: 320px;
        }

        .chart-wrap--small {
        height: 200px;
        }

        .inventory-health {
        text-align: center;
        padding: 0.5rem 0 0.75rem;
        }

        .inventory-health__meter {
        width: 100%;
        height: 12px;
        background: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
        }

        .inventory-health__fill {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, #2563eb 0%, #3b82f6 100%);
        border-radius: inherit;
        }

        .inventory-health__value {
        margin-top: 0.9rem;
        font-size: 1.8rem;
        font-weight: 800;
        letter-spacing: -0.05em;
        color: #0f172a;
        }

        .inventory-health p,
        .panel__label {
        margin: 0.4rem 0 0;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        }

        .inventory-genres {
        border-top: 1px solid #edf2f7;
        margin-top: 1rem;
        padding-top: 1rem;
        }

        .table-shell {
        overflow: hidden;
        border: 1px solid #edf2f7;
        border-radius: 14px;
        background: #fff;
        }

        .dashboard-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
        }

        .dashboard-table thead {
        background: #f8fafc;
        }

        .dashboard-table th,
        .dashboard-table td {
        padding: 0.9rem 1rem;
        border-bottom: 1px solid #edf2f7;
        text-align: left;
        vertical-align: middle;
        }

        .dashboard-table th {
        color: #475569;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        }

        .dashboard-table tbody tr:last-child td {
        border-bottom: none;
        }

        .dashboard-table tbody tr:hover {
        background: #f8fbff;
        }

        .badge--danger {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-width: 78px;
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
        background: #fef2f2;
        color: #dc2626;
        font-weight: 700;
        }

        .dashboard-table__action {
        border: 1px solid rgba(220, 38, 38, 0.2);
        color: #dc2626;
        background: #fff;
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        font-weight: 700;
        }

        .borrower-list {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        }

        .borrower-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        padding: 0.7rem 0.1rem;
        border-bottom: 1px solid #edf2f7;
        }

        .borrower-row:last-child {
        border-bottom: none;
        }

        .borrower-row__identity {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        min-width: 0;
        }

        .borrower-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 0.75rem;
        font-weight: 800;
        flex-shrink: 0;
        }

        .borrower-row__identity p {
        margin: 0;
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 700;
        }

        .borrower-row__identity span {
        display: block;
        margin-top: 0.12rem;
        color: #64748b;
        font-size: 0.7rem;
        }

        .borrower-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.45rem 0.6rem;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
        }

        .empty-state {
        display: grid;
        place-items: center;
        text-align: center;
        padding: 2rem 1rem 1rem;
        color: #64748b;
        }

        .empty-state i {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        }

        .empty-state p {
        margin: 0;
        font-size: 0.85rem;
        }

        @@media (max-width: 991.98px) {
        .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-grid--top,
        .dashboard-grid--bottom {
        grid-template-columns: 1fr;
        }
        }

        @@media (max-width: 767.98px) {
        .page-header {
        flex-direction: column;
        align-items: flex-start;
        }

        .page-header__actions {
        margin-left: 0;
        }

        .stats-grid {
        grid-template-columns: 1fr;
        }

        .table-shell {
        overflow: hidden;
        border: none;
        }

        .dashboard-table,
        .dashboard-table thead,
        .dashboard-table tbody,
        .dashboard-table th,
        .dashboard-table td,
        .dashboard-table tr {
        display: block;
        width: 100%;
        }

        .dashboard-table thead {
        display: none;
        }

        .dashboard-table tbody {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        }

        .dashboard-table tr {
        background: #fff;
        border: 1px solid #edf2f7;
        border-radius: 16px;
        padding: 0.9rem;
        box-shadow: 0 12px 20px rgba(15, 23, 42, 0.03);
        }

        .dashboard-table td {
        padding: 0.4rem 0;
        border: none;
        }

        .dashboard-table td::before {
        content: attr(data-label);
        display: block;
        margin-bottom: 0.2rem;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        }

        .dashboard-table td.text-end {
        text-align: left;
        }

        .borrower-row {
        flex-direction: column;
        align-items: flex-start;
        }
        }
    </style>