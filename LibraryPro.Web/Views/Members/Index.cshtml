@model IEnumerable<LibraryPro.Web.Models.Entities.Member>
@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Library Members";
}

<div class="container-fluid px-4 py-4 animate-fade-in">
    <div class="page-header mb-4">
        <div class="page-header__title-block">
            <p class="page-header__eyebrow">Directory</p>
            <h1 class="page-header__title">Member</h1>
        </div>

        <div class="page-header__actions">
            <div class="search-shell">
                <span class="search-shell__icon"><i class="bi bi-search"></i></span>
                <input type="text" id="memberSearch" class="search-shell__input" placeholder="Search patrons...">
            </div>

            @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
            {
                <a asp-action="Register" class="btn page-header__cta">
                    <span class="page-header__cta-icon"><i class="bi bi-person-plus-fill"></i></span>
                    <span class="page-header__cta-text">New<br>Registration</span>
                </a>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
            <div class="card border-0 shadow-sm p-4 bg-light-blue h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <div>
                        <small class="text-uppercase fw-bold text-primary opacity-75 d-block">Total Patrons</small>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="member-directory-list">
        @foreach (var m in Model)
        {
            var isOverdue = ((List<int>)ViewBag.OverdueMemberIds).Contains(m.Id);

            <article class="member-directory-card">
                <div class="member-directory-main">
                    <div class="member-avatar" aria-label="Member initials">
                        @(string.IsNullOrEmpty(m.Name) ? "M" : m.Name.Substring(0, 1).ToUpper())
                    </div>

                    <div class="member-directory-meta">
                        <div class="member-directory-header">
                            <div class="member-directory-header-stack">
                                <h3>@m.Name</h3>
                                @if (isOverdue)
                                {
                                    <span class="member-status member-status--danger">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Overdue
                                    </span>
                                }
                                else
                                {
                                    <span class="member-status member-status--success">
                                        <i class="bi bi-check-circle-fill"></i> Active Member
                                    </span>
                                }
                            </div>

                            <div class="dropdown member-action-menu-wrap">
                                <button class="btn btn-light member-action-menu" type="button" data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 member-action-menu-list">
                                    <li><a asp-action="Edit" asp-route-id="@m.Id" class="dropdown-item py-2"><i
                                        class="bi bi-pencil me-2 text-muted"></i>Edit Details</a></li>
                                        <li><a asp-action="Details" asp-route-id="@m.Id" class="dropdown-item py-2"><i
                                            class="bi bi-info-circle me-2 text-muted"></i>General Info</a></li>
                                            <li>
                                                <hr class="dropdown-divider">
                                            </li>
                                            <li><button type="button" onclick="confirmMemberDelete('@m.Id', '@m.Name')"
                                                        class="dropdown-item py-2 text-danger"><i class="bi bi-trash me-2"></i>Remove
                                                Patron</button></li>
                                            </ul>
                                        </div>
                        </div>

                        <div class="member-contact-list">
                            <div class="member-contact-item"><i class="bi bi-envelope"></i> @m.Email</div>
                            <div class="member-contact-item"><i class="bi bi-telephone"></i> @m.PhoneNumber</div>
                            <div class="member-contact-item"><i class="bi bi-calendar3"></i> @m.MembershipDate.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>
                </div>
            </article>
                    }
                </div>
            </div>

            <style>
                /* Gradient Avatar */
                .avatar-circle {
                    width: 42px;
                    height: 42px;
                    background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
                    color: white;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: bold;
                    flex-shrink: 0;
                }

                /* Soft Colors */
                .bg-success-soft {
                    background-color: #ecfdf5;
                    color: #059669;
                }

                .bg-danger-soft {
                    background-color: #fef2f2;
                    color: #dc2626;
                    border: 1px solid #fee2e2;
                }

                .bg-light-blue {
                    background-color: #f0f4ff;
                }

                .page-header {
                    display: flex;
                    align-items: flex-end;
                    justify-content: space-between;
                    gap: 1.5rem;
                    padding: 0.25rem 0 0.5rem;
                    border-bottom: 1px solid rgba(148, 163, 184, 0.35);
                }

                .page-header__title-block {
                    display: flex;
                    flex-direction: column;
                    align-items: flex-start;
                    min-width: 0;
                }

                .page-header__eyebrow {
                    margin: 0;
                    font-size: 1rem;
                    font-weight: 700;
                    letter-spacing: 0.18em;
                    text-transform: uppercase;
                    color: #64748b;
                }

                .page-header__title {
                    margin: 0;
                    font-size: clamp(2.2rem, 3.4vw, 4rem);
                    line-height: 0.95;
                    font-weight: 600;
                    letter-spacing: -0.06em;
                    color: #0f172a;
                }

                .page-header__actions {
                    display: flex;
                    align-items: center;
                    justify-content: flex-end;
                    gap: 1rem;
                    width: min(100%, 720px);
                    flex: 1;
                }

                .search-shell {
                    display: flex;
                    align-items: center;
                    flex: 1;
                    min-width: 220px;
                    background: rgba(255, 255, 255, 0.55);
                    border: 1px solid rgba(148, 163, 184, 0.9);
                    border-radius: 16px;
                    height: 64px;
                    padding: 0 1rem 0 0.9rem;
                    box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.03);
                }

                .search-shell__icon {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 36px;
                    height: 36px;
                    border-radius: 10px;
                    background: rgba(148, 163, 184, 0.08);
                    color: #64748b;
                    font-size: 1.1rem;
                    margin-right: 0.75rem;
                }

                .search-shell__input {
                    border: 0;
                    background: transparent;
                    width: 100%;
                    height: 100%;
                    font-size: 1rem;
                    color: #0f172a;
                    outline: none;
                }

                .search-shell__input::placeholder {
                    color: #94a3b8;
                }

                .page-header__cta {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 0.75rem;
                    background: linear-gradient(135deg, #2f6ef5 0%, #1d4ed8 100%);
                    color: #fff;
                    border: 0;
                    border-radius: 20px;
                    min-width: 170px;
                    height: 64px;
                    padding: 0.75rem 1.2rem;
                    box-shadow: 0 12px 24px rgba(37, 99, 235, 0.28);
                    transition: transform 0.2s ease, box-shadow 0.2s ease;
                }

                .page-header__cta:hover {
                    color: #fff;
                    transform: translateY(-1px);
                    box-shadow: 0 16px 26px rgba(37, 99, 235, 0.3);
                }

                .page-header__cta-icon {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 32px;
                    height: 32px;
                    border-radius: 10px;
                    background: rgba(255, 255, 255, 0.14);
                    font-size: 1rem;
                }

                .page-header__cta-text {
                    line-height: 1.1;
                    font-weight: 700;
                    font-size: 1.02rem;
                    text-align: left;
                }

                .member-directory-list {
                    display: grid;
                    gap: 1rem;
                }

                .member-directory-card {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 1rem;
                    background: #ffffff;
                    border: 1px solid #e5e7eb;
                    border-radius: 18px;
                    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
                    padding: 1.1rem 1.2rem;
                    transition: box-shadow 0.2s ease, transform 0.2s ease;
                }

                .member-directory-card:hover {
                    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
                    transform: translateY(-1px);
                }

                .member-directory-main {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    min-width: 0;
                    flex: 1;
                }

                .member-avatar {
                    width: 52px;
                    height: 52px;
                    border-radius: 16px;
                    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
                    color: #ffffff;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.25rem;
                    font-weight: 700;
                    flex-shrink: 0;
                }

                .member-directory-meta {
                    min-width: 0;
                    flex: 1;
                }

                .member-directory-header {
                    display: flex;
                    align-items: flex-start;
                    justify-content: space-between;
                    gap: 0.75rem;
                    flex-wrap: nowrap;
                    margin-bottom: 0.5rem;
                }

                .member-directory-header-stack {
                    display: flex;
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 0.45rem;
                    min-width: 0;
                    flex: 1;
                }

                .member-directory-header h3 {
                    margin: 0;
                    font-size: 1.2rem;
                    font-weight: 700;
                    color: #111827;
                    line-height: 1.3;
                }

                .member-status {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.35rem;
                    border-radius: 999px;
                    padding: 0.28rem 0.7rem;
                    font-size: 0.72rem;
                    font-weight: 700;
                    letter-spacing: 0.02em;
                }

                .member-status--success {
                    background: #ecfdf5;
                    color: #059669;
                }

                .member-status--danger {
                    background: #fef2f2;
                    color: #dc2626;
                }

                .member-contact-list {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.55rem 1rem;
                    color: #475569;
                    font-size: 0.9rem;
                }

                .member-contact-item {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.45rem;
                    min-width: 0;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .member-contact-item i {
                    color: #64748b;
                }

                .member-directory-actions {
                    display: flex;
                    align-items: center;
                    justify-content: flex-end;
                    gap: 0.75rem;
                    flex-shrink: 0;
                }

                .member-action-primary {
                    min-width: 150px;
                    border-radius: 999px;
                    padding: 0.72rem 1.25rem;
                    font-weight: 700;
                    box-shadow: 0 8px 18px rgba(59, 130, 246, 0.22);
                }

                .member-action-menu {
                    width: 42px;
                    height: 42px;
                    border-radius: 50%;
                    border: 1px solid #e2e8f0;
                    background: #f8fafc;
                    color: #0f172a;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                }

                .member-action-menu-list {
                    z-index: 1060;
                    min-width: 190px;
                    border-radius: 14px;
                    padding: 0.45rem 0;
                }

                .animate-fade-in {
                    animation: fadeIn 0.4s ease-out;
                }

                .swal2-toast-custom {
                    border-radius: 12px !important;
                    padding: 1rem !important;
                    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
                }

                .swal2-timer-progress-bar-custom {
                    background: var(--primary-gradient) !important;
                }

                @@keyframes fadeIn {
                    from {
                        opacity: 0;
                        transform: translateY(8px);
                    }

                    to {
                        opacity: 1;
                        transform: translateY(0);
                    }
                }

                @@media (max-width: 991.98px) {
                    .page-header {
                        flex-direction: column;
                        align-items: stretch;
                    }

                    .page-header__actions {
                        width: 100%;
                    }
                }

                @@media (max-width: 767.98px) {
                    .page-header {
                        gap: 1rem;
                    }

                    .page-header__actions {
                        flex-direction: column;
                        align-items: stretch;
                    }

                    .search-shell {
                        width: 100%;
                        min-width: 0;
                    }

                    .page-header__cta {
                        width: 100%;
                        min-width: 0;
                        justify-content: center;
                    }

                    .member-directory-card {
                        flex-direction: column;
                        align-items: stretch;
                        padding: 1rem;
                    }

                    .member-directory-main {
                        align-items: flex-start;
                    }

                    .member-directory-header {
                        flex-direction: row;
                        align-items: flex-start;
                        justify-content: space-between;
                        width: 100%;
                        margin-bottom: 0.6rem;
                    }

                    .member-directory-header-stack {
                        width: 100%;
                    }

                    .member-action-menu-wrap {
                        flex-shrink: 0;
                        margin-top: 0.1rem;
                    }

                    .member-contact-list {
                        display: grid;
                        gap: 0.45rem;
                    }
                }

                @@media (max-width: 480px) {
                    .page-header__eyebrow {
                        font-size: 0.72rem;
                        letter-spacing: 0.14em;
                    }

                    .page-header__title {
                        font-size: 2.1rem;
                    }

                    .search-shell {
                        height: 54px;
                        border-radius: 14px;
                    }

                    .page-header__cta {
                        height: 54px;
                        border-radius: 14px;
                    }

                    .member-directory-card {
                        border-radius: 14px;
                    }

                    .member-avatar {
                        width: 46px;
                        height: 46px;
                        border-radius: 14px;
                        font-size: 1.05rem;
                    }

                    .member-directory-header h3 {
                        font-size: 1.05rem;
                    }

                    .member-contact-item {
                        white-space: normal;
                    }
                }
            </style>

            @section Scripts {
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                <script>
                    // REAL-TIME SEARCH
                    const memberSearchInput = document.getElementById('memberSearch');
                    if (memberSearchInput) {
                    memberSearchInput.addEventListener('keyup', function () {
                    const value = this.value.toLowerCase();
                    const cards = document.querySelectorAll('.member-directory-card');

                    cards.forEach(card => {
                    const text = card.innerText.toLowerCase();
                    card.style.display = text.includes(value) ? '' : 'none';
                    });
                    });
                    }

                    // DELETE CONFIRMATION
                    function confirmMemberDelete(id, name) {
                    Swal.fire({
                    title: 'Confirm Deletion',
                    text: `Removing ${name} will permanently delete their record. Proceed?`,
                    icon: 'warning', // Changed to warning for better UX
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, Delete Patron',
                    background: '#fff',
                    customClass: { popup: 'rounded-4' }
                    }).then((result) => {
                    if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Members/Delete/' + id;

                    // THE FIX: Grabbing the Anti-Forgery Token
                    const token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (token) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                    }

                    document.body.appendChild(form);
                    form.submit();
                    }
                    });
                    }
                </script>
            }