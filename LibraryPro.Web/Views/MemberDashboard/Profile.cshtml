@model LibraryPro.Web.Models.Entities.Member

@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid px-4 py-4 animate-fade-in">
    <div class="page-header mb-4">
        <div class="page-header__title-block">
            <p class="page-header__eyebrow">Account Settings</p>
            <h1 class="page-header__title">My Profile</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person-gear me-2 text-primary"></i>Personal Information
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateProfile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold">Full Name</label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold">Email Address</label>
                                <input asp-for="Email" class="form-control" readonly class="bg-light" />
                                <small class="text-muted">Email cannot be changed</small>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold">Member Since</label>
                                <input type="text" class="form-control bg-light" value="@Model.MembershipDate.ToString("MMM dd, yyyy")" readonly />
                            </div>
                        </div>

                        <hr class="my-4">

                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-bell me-2"></i>Notification Preferences
                        </h6>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" asp-for="ReceiveDueDateReminders" id="dueDateReminders">
                            <label class="form-check-label" for="dueDateReminders">
                                Receive due date reminders
                            </label>
                            <small class="text-muted d-block">Get notified before your books are due</small>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" asp-for="ReceiveOverdueNotices" id="overdueNotices">
                            <label class="form-check-label" for="overdueNotices">
                                Receive overdue notices
                            </label>
                            <small class="text-muted d-block">Get notified when books become overdue</small>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" asp-for="ReceiveReservationAlerts" id="reservationAlerts">
                            <label class="form-check-label" for="reservationAlerts">
                                Receive reservation alerts
                            </label>
                            <small class="text-muted d-block">Get notified when reserved books become available</small>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2 text-info"></i>Account Info
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Member ID</label>
                        <div class="fw-bold">#@Model.Id</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Email</label>
                        <div class="fw-bold">@Model.Email</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Phone</label>
                        <div class="fw-bold">@Model.PhoneNumber</div>
                    </div>
                    <div>
                        <label class="form-label text-muted small">Member Since</label>
                        <div class="fw-bold">@Model.MembershipDate.ToString("MMM dd, yyyy")</div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-shield-check me-2 text-success"></i>Account Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <div>
                            <div class="fw-bold">Active</div>
                            <small class="text-muted">Your account is in good standing</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}